# انسخ هذا الملف إلى .env وضع القيم الفعلية — لا ترفع .env نفسه إلى GitHub أبدًا

# مفتاح مجاني من https://twelvedata.com/
TWELVE_DATA_API_KEY=ضع_مفتاحك_هنا

# رابط موقع الواجهة الأمامية بعد نشره (لأمان CORS)، افصل عدة روابط بفاصلة
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
